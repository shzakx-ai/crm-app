# Copy to .env and fill in real values

# First admin credentials (seeded into users table on first run)
CRM_ADMIN_USER=admin
CRM_ADMIN_PASSWORD=change-me-strong-password

# Session signing secret — MUST be stable across restarts or sessions invalidate
CRM_SESSION_SECRET=change-me-random-secret-32-chars

# Optional: Bearer token for external API clients (set to enable)
CRM_API_TOKEN=

# Set true behind HTTPS (sets Secure flag on session cookie)
CRM_COOKIE_SECURE=false

# Set to true ONLY when behind a trusted reverse proxy that cleans X-Forwarded-For
TRUST_PROXY=false